# PostgreSQL (use a long random password)
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
# Sólo es necesario cambiarlo si otro servicio local ya usa el puerto 5432.
POSTGRES_PORT=5432

# n8n - generate N8N_ENCRYPTION_KEY with: .\\scripts\\generate-secrets.ps1
N8N_ENCRYPTION_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
# n8n API key for Automation Center Backend - generate with: .\\scripts\\generate-secrets.ps1
N8N_API_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
TZ=Europe/Madrid
N8N_LOG_LEVEL=info
# En local HTTP debe ser false. En un dominio HTTPS público, cámbialo a true.
N8N_SECURE_COOKIE=false
# DNS del servicio dentro de Docker. Para un n8n fuera de Docker usa http://localhost:3000.
PLAYWRIGHT_BASE_URL=http://playwright:3000

# Google AI Studio
GEMINI_API_KEY=PASTE_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=PASTE_PERMANENT_ACCESS_TOKEN
WHATSAPP_RECIPIENT=34600111222

# Google Drive folders. Use real folder IDs, not names.
# Suggested structure:
# TDR/
#   OpenAI/
#   Google/
#   Microsoft/
#   NVIDIA/
#   Espacio/
GOOGLE_DOCS_FOLDER_ID=
GOOGLE_DOCS_FOLDER_OPENAI_ID=
GOOGLE_DOCS_FOLDER_GOOGLE_ID=
GOOGLE_DOCS_FOLDER_MICROSOFT_ID=
GOOGLE_DOCS_FOLDER_NVIDIA_ID=
GOOGLE_DOCS_FOLDER_ESPACIO_ID=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_TELEGRAM_CHAT_ID_HERE

# Backend / Automation Center
BACKEND_SECRET_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Google OAuth - required for Google OAuth provider
GOOGLE_CLIENT_ID=PASTE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=PASTE_GOOGLE_CLIENT_SECRET
